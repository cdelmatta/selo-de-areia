; Configuração do projeto Selo de Areia.
config_version=5

[application]
config/name="Selo de Areia"
run/main_scene="res://scenes/templo.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Projeto de Jogos Digitais II: templo perdido, modo Horda e tipo Chefe."

[display]
window/size/viewport_width=640
window/size/viewport_height=384
window/size/window_width_override=1280
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[input]
left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194321)]
}
right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194323)]
}
up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}

[layer_names]
2d_physics/layer_1="mundo"
2d_physics/layer_2="jogador"
2d_physics/layer_3="inimigo"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.08, 0.065, 0.06, 1)
